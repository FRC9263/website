{
  // Must match the Worker name in Cloudflare exactly, or builds fail
  "name": "frc9263-website",
  "compatibility_date": "2026-11-06",
  "assets": {
    // Folder holding the finished web pages (made by build.py)
    "directory": "./public",
    // Unknown URLs get public/404.html
    "not_found_handling": "404-page"
  }
}
